msgid "24 hour format"
msgstr "Μορφή 24 ωρών"

msgid "3. Solve it. The result goes back to the receiver by itself and the captcha window closes."
msgstr "3. Λύστε το. Το αποτέλεσμα επιστρέφει αυτόματα στον δέκτη και το παράθυρο captcha κλείνει."

msgid "<font color=\"#FE642E\">REMEMBER:</font></b> E2iPlayer <b>IS ONLY</b> specialized Web browser. It does <b>NOT</b> host any materials!!!</font>"
